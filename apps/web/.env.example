# Patty Web Environment Variables
# Copy this file to .env.local and fill in the values.

# Hono API base URL (server-side only)
# In Railway production, use the private network URL for lower latency:
# http://patty-api.railway.internal:8080
API_INTERNAL_URL=http://localhost:8080

# Admin JWT secret — must match the API's ADMIN_JWT_SECRET
ADMIN_JWT_SECRET=change_me_admin_in_production_minimum_32

# App store links (public — safe to expose)
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/patty
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.patty
