# Test Environment Variables
# Copy this file to .env.test and update values as needed

# Test Database URL
# Override with CI-provided URL or use local default
TEST_DATABASE_URL=postgresql://pati:pati@localhost:5432/pati_test

# JWT Secret (minimum 32 characters)
TEST_JWT_SECRET=patty-test-secret-key-minimum-32-characters

# Cloudinary (use test cloud)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

# Resend (use test API key)
RESEND_API_KEY=re_test_placeholder
RESEND_SENDER_EMAIL=verification@patty.app

# Server
PORT=8080
LOG_LEVEL=error

# Database
DB_POOL_SIZE=5

# Rate limiting (optional, lower for tests)
EMAIL_IP_THROTTLE_LIMIT=10
EMAIL_DAILY_CAP=100

# Super Admin Seeds
INITIAL_SUPER_ADMIN_EMAIL=admin.mail@patty.com.tr
INITIAL_SUPER_ADMIN_PASSWORD=admin_password
