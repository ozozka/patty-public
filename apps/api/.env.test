# Test Database URL
DATABASE_URL=postgresql://pati:pati@localhost:5432/pati_test

# JWT Secret (minimum 32 characters)
JWT_SECRET=test-secret-key-that-is-at-least-32-chars

# Cloudinary (use test cloud for tests)
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

# Resend (use test API key)
RESEND_API_KEY=re_placeholder
RESEND_SENDER_EMAIL=test@patty.app

# Server
PORT=8080
LOG_LEVEL=silent

# Database
DB_POOL_SIZE=5

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting (higher for tests to avoid rate limit errors)
EMAIL_IP_THROTTLE_LIMIT=10
EMAIL_DAILY_CAP=100

# Admin JWT
ADMIN_JWT_SECRET=test-admin-secret-key-that-is-at-least-32

# Super Admin Seeds
INITIAL_SUPER_ADMIN_EMAIL=admin.mail@patty.com.tr
INITIAL_SUPER_ADMIN_PASSWORD=admin_password
