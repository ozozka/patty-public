{
  "name": "@patty/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./dist/types.d.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "eslint src --quiet",
    "fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:types": "tsup src/types.ts --format esm --dts --clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@patty/contracts": "workspace:*",
    "cloudinary": "^2.6.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.1",
    "expo-server-sdk": "^3.13.0",
    "hono": "^4.8.3",
    "jose": "^5.10.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.7",
    "resend": "^4.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@patty/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.14",
    "@types/pino": "^7.0.5",
    "bun-types": "^1.3.10",
    "drizzle-kit": "^0.31.1",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
