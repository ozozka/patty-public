# Patty API Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgresql://pati:pati@localhost:5432/pati

# JWT secret (minimum 32 characters)
JWT_SECRET=change_me_in_production_minimum_32_chars

# Admin JWT secret — separate from JWT_SECRET (minimum 32 characters)
ADMIN_JWT_SECRET=change_me_admin_in_production_minimum_32

# Cloudinary — image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email (re_placeholder enables mock mode)
RESEND_API_KEY=re_placeholder
RESEND_SENDER_EMAIL=verification@patty.app

# Server
PORT=8080
LOG_LEVEL=info

# Database
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting (optional)
EMAIL_IP_THROTTLE_LIMIT=10
EMAIL_DAILY_CAP=100

# Super Admin Seeds
INITIAL_SUPER_ADMIN_EMAIL=admin.mail@patty.com.tr
INITIAL_SUPER_ADMIN_PASSWORD=admin_password

# E2E Maestro Setup
MAESTRO_SECRET=local-maestro-secret
E2E_TEST_EMAIL=test-maestro@patty.app
E2E_BYPASS_CODE=123456

