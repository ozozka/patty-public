# Patty Mobile Environment Variables
# Copy this file to .env and update the values.
#
# Quick start:
#   just mobile/local   — connect to local Docker backend
#   just mobile/prod    — connect to production (pati.fly.dev)
#   just mobile/run     — use whatever is set below

# Backend API base URL
# Local (iOS Simulator / physical device on same network): http://localhost:8080/api/v1/
# Local (Android Emulator): http://10.0.2.2:8080/api/v1/
# Production: https://pati.fly.dev/api/v1/
EXPO_PUBLIC_BASE_URL=http://localhost:8080/api/v1/

# Expo/EAS CLI token (needed only for builds and OTA updates)
EXPO_TOKEN=

