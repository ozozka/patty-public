{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_BASE_URL": "http://localhost:8080/api/v1/",
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://patty-api-production.up.railway.app/api/v1/",
        "NODE_ENV": "production"
      },
      "cache": {
        "paths": []
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://patty-api-production.up.railway.app/api/v1/",
        "NODE_ENV": "production"
      },
      "cache": {
        "paths": []
      }
    }
  },
  "submit": {
    "production": {}
  }
}
