FROM oven/bun:1.3.10 AS base
WORKDIR /app

# ── deps: install all workspace deps ─────────────────────────────────────────
FROM base AS deps
COPY package.json bun.lock ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/config/package.json ./packages/config/
COPY packages/assets/package.json ./packages/assets/
RUN bun install

# ── builder: build assets → contracts → API types → Next.js ──────────────────
FROM deps AS builder
COPY . .
RUN bun run --filter @patty/assets build
RUN bun run --filter @patty/contracts build
RUN bun run --filter @patty/api build:types
RUN bun run --filter @patty/web build

# ── runner: standalone output (no node_modules reinstall needed) ──────────────
# next.config.ts sets output:"standalone". The standalone directory is a
# self-contained server with all traced deps bundled in — no npm install needed.
FROM base AS runner
ENV NODE_ENV=production

# Copy the standalone bundle (includes server.js + traced node_modules + .next/server)
COPY --from=builder /app/apps/web/.next/standalone/ ./

# Static assets and public dir must be copied alongside server.js
# inside the monorepo folder structure created by standalone
COPY --from=builder /app/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=builder /app/apps/web/public/ ./apps/web/public/

USER bun
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["bun", "apps/web/server.js"]
