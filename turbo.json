{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "generated/**"]
    },
    "build:types": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL", "JWT_SECRET", "ADMIN_JWT_SECRET", "CLOUDINARY_CLOUD_NAME", "CLOUDINARY_API_KEY", "CLOUDINARY_API_SECRET", "RESEND_API_KEY", "RESEND_SENDER_EMAIL"]
    },
    "fix": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL", "JWT_SECRET", "ADMIN_JWT_SECRET", "CLOUDINARY_CLOUD_NAME", "CLOUDINARY_API_KEY", "CLOUDINARY_API_SECRET", "RESEND_API_KEY", "RESEND_SENDER_EMAIL"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^build:types"],
      "outputs": [],
      "env": ["DATABASE_URL", "JWT_SECRET", "ADMIN_JWT_SECRET", "CLOUDINARY_CLOUD_NAME", "CLOUDINARY_API_KEY", "CLOUDINARY_API_SECRET", "RESEND_API_KEY", "RESEND_SENDER_EMAIL"]
    }
  }
}
